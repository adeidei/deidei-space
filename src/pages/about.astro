---
import BaseLayout from "../layouts/BaseLayout.astro";

const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: "Deidei",
	url: "https://deidei.space",
	sameAs: ["https://github.com/adeidei", "https://x.com/deideibuilds"],
	knowsAbout: ["AI engineering", "software products", "entrepreneurship", "cross-domain learning", "idea development"],
};
---

<BaseLayout
	title="About — Deidei"
	description="Deidei is a builder and thinking partner who learns across fields and helps ideas become concrete enough to act on."
	canonicalPath="/about/"
	structuredData={personSchema}
>
	<section class="page-intro wrap ruled-section">
		<p class="eyebrow">About / the short version</p>
		<h1>I’m a builder<br />and thinking partner.</h1>
		<p class="lede">
			I’m learning AI engineering, building products, studying entrepreneurship, and following questions across different fields. I like finding the connection that turns a fuzzy idea into something a person can act on.
		</p>
	</section>

	<section class="wrap about-grid">
		<div class="about-main prose">
			<h2>Why this site exists</h2>
			<p>
				Sometimes I start with a question I want to answer. Sometimes someone brings me an idea they haven’t figured out yet. In both cases, I look for useful patterns and tools, then help turn the idea into something we can test.
			</p>
			<p>
				I use this site to write down what I tried, what changed, and what I want to explore next.
			</p>
		</div>
		<aside class="about-aside" aria-label="Recurring subjects">
			<p class="eyebrow">Recurring threads</p>
			<ul>
				<li>Learning AI engineering through real products</li>
				<li>Turning fuzzy ideas into actionable shapes</li>
				<li>Building products that can survive in the world</li>
				<li>Becoming more capable across fields</li>
			</ul>
		</aside>
	</section>
</BaseLayout>
