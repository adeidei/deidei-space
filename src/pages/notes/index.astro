---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const notes = (await getCollection("notes", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const labels = {
	curiosity: "Curiosity",
	progress: "Progress",
	insight: "Insight",
} as const;

const formatDate = (date: Date) =>
	new Intl.DateTimeFormat("en", {
		month: "short",
		day: "numeric",
		year: "numeric",
	}).format(date);
---

<BaseLayout
	title="Notes — Deidei"
	description="Notes on what Deidei is learning, building, and thinking through."
	canonicalPath="/notes/"
>
	<section class="page-intro wrap ruled-section">
		<p class="eyebrow">Notes</p>
		<h1>What I’m learning<br />and building.</h1>
		<p class="lede">
			Questions I’m exploring, things I’m working on, and ideas I want to remember.
		</p>
	</section>

	<section class="wrap notes-page" aria-labelledby="entries-heading">
		<div class="section-heading">
			<h2 id="entries-heading">All notes</h2>
			<p>{notes.length.toString().padStart(2, "0")} published</p>
		</div>
		<div class="note-list">
			{notes.map((note, index) => (
				<a class="note-row" href={`/notes/${note.id}/`}>
					<span class="note-number">{String(index + 1).padStart(2, "0")}</span>
					<span class={`kind kind-${note.data.kind}`}>{labels[note.data.kind]}</span>
					<span class="note-copy">
						<strong>{note.data.title}</strong>
						<small>{note.data.description}</small>
					</span>
					<time datetime={note.data.publishedAt.toISOString()}>{formatDate(note.data.publishedAt)}</time>
					<span class="arrow" aria-hidden="true">↗</span>
				</a>
			))}
		</div>
	</section>
</BaseLayout>
